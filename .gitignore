# Binary wheels (never commit these)
*.whl

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Large model files
*.dat
*.bz2

# OS files
.DS_Store
Thumbs.db

# OpenCV temp files
*.avi
*.mp4
```

